# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Java compilation output
/java/bin/
*.class

# Runtime test data and logs (anchored to /data, preserving .gitkeep)
/data/*.dat
/data/*.log
!/data/.gitkeep

# Dependencies
/node_modules
/.pnp
.pnp.js
/frontend/node_modules/

# Testing & Coverage
/coverage

# Next.js and frontend builds
/.next/
/out/
/build
/frontend/.next/
/frontend/out/

# Local environment and secret files
.env*.local
.env
/mysql/local_*.sql

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.swp
*.swo

# Debug and cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
next-env.d.ts
